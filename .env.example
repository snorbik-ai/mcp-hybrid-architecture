# ==============================================================================
# Configuration des Serveurs MCP Hybrides — Valeurs Fictives d'Exemple
# ==============================================================================

# Port d'écoute de la passerelle unifiée Streamable HTTP (Porte A)
MCP_GATEWAY_PORT=5185
MCP_GATEWAY_HOST=127.0.0.1

# Mode d'exécution par défaut (mcp_stdio | agent_coding_cli)
DEFAULT_EXECUTION_MODE=mcp_stdio

# Niveau de journalisation (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Timeout maximal par appel d'outil (secondes)
TOOL_TIMEOUT_SECONDS=30
